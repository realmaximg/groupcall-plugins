__id__ = "groupcall_hide_me_demo"
__name__ = "GroupCall Ghost (demo)"
__description__ = "Демо бага: пытается выписать тебя из реестра участников видеочата, не разрывая аудио. Команды в любом чате: .ghost / .unghost"
__author__ = "realmaximg"
__version__ = "2.1.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"

from base_plugin import BasePlugin, MethodHook, HookResult, HookStrategy
from hook_utils import find_class, get_private_field
from client_utils import send_request
from android_utils import run_on_ui_thread
from java.lang import Boolean, Integer
from java import jint
from org.telegram.tgnet import TLRPC
from org.telegram.messenger.voip import VoIPService


class _BlockWhenGhost(MethodHook):
    """Пока призрак — не даём клиенту самому перезайти."""
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.ghost:
            param.setResult(None)


class GhostDemo(BasePlugin):
    def on_plugin_load(self):
        self.ghost = False
        # команды регистрируем первыми — чтобы работали, даже если хуки не встанут
        self.add_on_send_message_hook()
        try:
            cls = find_class("org.telegram.messenger.voip.VoIPService")
            m1 = cls.getDeclaredMethod("startGroupCheckShortpoll")
            m1.setAccessible(True)
            self.hook_method(m1, _BlockWhenGhost(self))
            m2 = cls.getDeclaredMethod("createGroupInstance", Integer.TYPE, Boolean.TYPE)
            m2.setAccessible(True)
            self.hook_method(m2, _BlockWhenGhost(self))
            self.logger.info("loaded, hooks ok")
        except Exception as e:
            self.logger.error(f"hook failed: {e}")

    def on_send_message_hook(self, account, params):
        text = getattr(params, "message", None)
        if not isinstance(text, str):
            return HookResult()
        cmd = text.strip().lower()
        if cmd == ".ghost":
            run_on_ui_thread(self._go_ghost)
        elif cmd == ".unghost":
            run_on_ui_thread(self._unghost)
        else:
            return HookResult()
        return HookResult(strategy=HookStrategy.CANCEL)

    def _toast(self, text):
        try:
            from ui.bulletin import BulletinHelper
            BulletinHelper.show_info(text)
        except Exception:
            pass
        self.logger.info(text)

    def _go_ghost(self):
        svc = VoIPService.getSharedInstance()
        if svc is None or svc.groupCall is None:
            self._toast("Ghost: ты не в видеочате")
            return
        try:
            my_source = get_private_field(svc, "mySource")[0]
            if my_source == 0:
                self._toast("Ghost: ещё не подключился (нет ssrc)")
                return
            self.ghost = True
            cancel = find_class("org.telegram.messenger.voip.VoIPService").getDeclaredMethod("cancelGroupCheckShortPoll")
            cancel.setAccessible(True)
            cancel.invoke(svc)

            req = TLRPC.TL_phone_leaveGroupCall()
            req.call = svc.groupCall.getInputGroupCall()
            req.source = my_source

            def done(resp, err):
                if resp is not None:
                    run_on_ui_thread(lambda: self._toast(f"Ghost: вышел из реестра, ssrc {my_source} жив"))
                else:
                    self.ghost = False
                    msg = err.text if err is not None else "?"
                    run_on_ui_thread(lambda: self._toast(f"Ghost: ошибка {msg}"))

            send_request(req, done)
        except Exception as e:
            self.ghost = False
            self._toast(f"Ghost: ошибка {e}")

    def _unghost(self):
        self.ghost = False
        svc = VoIPService.getSharedInstance()
        if svc is None:
            return
        try:
            m = find_class("org.telegram.messenger.voip.VoIPService").getDeclaredMethod("createGroupInstance", Integer.TYPE, Boolean.TYPE)
            m.setAccessible(True)
            m.invoke(svc, Integer(0), Boolean(False))
            self._toast("Ghost: перезашёл")
        except Exception as e:
            self._toast(f"Ghost: перезаход не удался {e}")
